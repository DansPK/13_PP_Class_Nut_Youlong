# Environment Configuration for RAG Chat with Documents

# OpenAI-compatible endpoint (e.g. local LLM server, LM Studio, vLLM, Azure OpenAI, etc.)
OPENAI_BASE_URL=http://localhost/v1
OPENAI_COMPATIBLE_API_KEY=your_api_key_here

# --- Models ---
# Embedding model
EMBED_MODEL=text-embedding-nomic-embed-text-v1.5

# Generation model
GEN_MODEL=qwen3-4b-instruct-2507

# --- Storage ---
# Directory containing source documents
DATA_DIR=data

# Directory for vector store persistence (ChromaDB)
CHROMA_DB_DIR=chroma_db

# Vector store collection name
COLLECTION_NAME=documents

# --- Chunking ---
# Size of text chunks in characters
CHUNK_SIZE=800

# Overlap between consecutive chunks in characters
CHUNK_OVERLAP=120

# --- Retrieval ---
# Number of chunks to retrieve per question
TOP_K=8
SIMILARITY_THRESHOLD=0.55

# --- Generation ---
# Sampling temperature for the chat Models
# Qdrant configuration
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=documents





